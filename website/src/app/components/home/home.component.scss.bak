// Home Page styles
.home-page {
  .hero-section {
    position: relative;
    height: 25vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: linear-gradient(135deg, var(--trust-navy) 0%, var(--primary-orange) 100%);
    
    .hero-content {
      position: relative;
      z-index: 2;
      width: 100%;
      color: var(--white);
      
      .container {
        text-align: center;
        padding: 0 2rem;
      }
      
      h1 {
        font-size: clamp(2.5rem, 5vw, 4.5rem);
        font-weight: 700;
        margin-bottom: 2rem;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
        color: var(--white);
        line-height: 1.1;
        
        @media (max-width: 768px) {
          font-size: 2.5rem;
          margin-bottom: 1.5rem;
        }
      }
      
      .hero-description {
        font-size: 1.375rem;
        max-width: 800px;
        margin: 0 auto 3rem;
        opacity: 0.95;
        color: var(--white);
        line-height: 1.6;
        text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.2);
        
        @media (max-width: 768px) {
          font-size: 1.125rem;
          margin-bottom: 2rem;
        }
      }
    }
    
    .hero-image {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
      
      &::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, rgba(11, 61, 145, 0.7) 0%, rgba(250, 116, 45, 0.7) 100%);
        z-index: 1;
      }
      
      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }
    
    @media (max-width: 768px) {
      height: 40vh;
    }
  }

  .features-section {
    padding: 6rem 0;
    background: var(--white);
    
    h2 {
      text-align: center;
      color: var(--trust-navy);
      font-size: 2.5rem;
      font-weight: 700;
      margin-bottom: 4rem;
      
      @media (max-width: 768px) {
        font-size: 2rem;
      }
    }
    
    .features-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
      gap: 3rem;
      margin-top: 3rem;
      
      @media (max-width: 768px) {
        grid-template-columns: 1fr;
        gap: 2rem;
      }
    }
    
    .feature-card {
      background: var(--white);
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
      transition: transform 0.3s ease;
      border: 1px solid rgba(11, 61, 145, 0.1);
      
      &:hover {
        transform: translateY(-8px);
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.12);
        border-color: var(--primary-orange);
      }
      
      img {
        width: 100%;
        height: 240px;
        object-fit: cover;
      }
      
      h3 {
        color: var(--trust-navy);
        margin: 1.5rem 1.5rem 1rem 1.5rem;
        font-size: 1.375rem;
        font-weight: 600;
      }
      
      p {
        color: var(--text-dark-gray);
        margin: 0 1.5rem 1.5rem 1.5rem;
        line-height: 1.6;
        font-size: 1.125rem;
      }
    }
  }

  .amenities-section {
    padding: 6rem 0;
    background: var(--soft-warm-gray);
    
    h2 {
      text-align: center;
      color: var(--trust-navy);
      font-size: 2.5rem;
      font-weight: 700;
      margin-bottom: 4rem;
      
      @media (max-width: 768px) {
        font-size: 2rem;
      }
    }
    
    .amenities-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2rem;
      max-width: 1000px;
      margin: 0 auto;
      
      @media (max-width: 768px) {
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }
    }
    
    .amenity-item {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 1.5rem;
      background: var(--white);
      border-radius: 12px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
      transition: transform 0.3s ease;
      border: 1px solid rgba(11, 61, 145, 0.05);
      
      &:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
        border-color: rgba(250, 116, 45, 0.3);
      }
      
      i {
        color: var(--primary-orange);
        font-size: 1.5rem;
        width: 2rem;
        text-align: center;
      }
      
      span {
        color: var(--trust-navy);
        font-weight: 500;
        font-size: 1.125rem;
      }
    }
  }

  /* Search + Grid (match Apartments/Condo styling) */
  .search-section {
    padding: 4rem 0;
    background: var(--soft-warm-gray);

    .search-card {
      margin-top: -3rem;
      position: relative;
      z-index: 3;
      
      &:hover {
        transform: none !important;
      }
      
      h2 {
        color: var(--text-dark-gray);
        margin-bottom: 2rem;
      }
    }

    .search-header {
      h2 {
        font-size: clamp(1.5rem, 4vw, 2rem) !important;
        color: var(--text-dark-gray) !important;
        font-weight: 600 !important;
        margin-bottom: 1.5rem !important;
        word-wrap: break-word;
        line-height: 1.3;
        
        @media (max-width: 767.98px) {
          font-size: 1.5rem !important;
          margin-bottom: 1rem !important;
          padding: 0 0.5rem;
          line-height: 1.4;
        }
        
        @media (max-width: 374.98px) {
          font-size: 1.375rem !important;
          padding: 0 0.25rem;
        }
      }
      
      .btn-filters-toggle {
        background: var(--primary-orange);
        color: var(--white);
        border: none;
        border-radius: 8px;
        padding: 0.75rem 1.5rem;
        font-size: 1rem;
        font-weight: 600;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        
        &:hover {
          background: var(--trust-navy);
        }
        
        @media (min-width: 768px) {
          &:hover {
            transform: translateY(-2px);
          }
        }

        i { transition: transform 0.3s ease; }
      }
    }

    .search-form {
      overflow: hidden;
      transition: all 0.3s ease;
      
      &.collapse { max-height: 0; padding: 0; margin: 0; opacity: 0; }
      &.collapse.show { max-height: 500px; padding: 1.5rem 0 0 0; opacity: 1; }

      .form-group { margin-bottom: 1.5rem; }
      .form-label { font-weight: 600; color: var(--text-dark-gray); margin-bottom: 0.5rem; }
      .form-control { height: 48px; border: 2px solid var(--light-gray); border-radius: 8px; }
      .form-control:focus { border-color: var(--primary-orange); box-shadow: 0 0 0 3px rgba(250, 116, 45, 0.1); }

      .options-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem 1.25rem; align-items: center; }
      .form-check { display: flex; align-items: center; gap: 0.5rem; min-height: 40px; }
      .form-check-label .me-2 { display: inline-block; width: 1.25rem; text-align: center; }
    }
  }

  .apartments-grid-section {
    padding: 4rem 0;

    .section-header {
      h2 {
        color: var(--text-dark-gray);
        font-size: 2.5rem;
        margin-bottom: 1rem;
      }

      .section-subtitle {
        color: var(--slate-accent);
        font-size: 1.125rem;
      }
    }

    .apartments-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
      gap: 2rem;
    }

    .apartment-card {
      overflow: hidden;
      transition: all 0.3s ease;

      &:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.15);

        .image-overlay {
          opacity: 1;
          visibility: visible;
          pointer-events: auto;
        }
      }

      .apartment-image {
        position: relative;
        height: 280px;
        overflow: hidden;
        background: var(--light-gray);

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          transition: transform 0.3s ease;
          display: block;
        }

        &:hover img {
          transform: scale(1.05);
        }

        .apartment-badge {
          position: absolute;
          top: 1rem;
          left: 1rem;
          padding: 0.5rem 1rem;
          border-radius: 20px;
          font-size: 0.75rem;
          font-weight: 600;
          text-transform: uppercase;
          background: rgba(0, 0, 0, 0.7);
          color: var(--white);

          &.available {
            background: var(--success-green);
          }
        }

        .apartment-price {
          position: absolute;
          top: 1rem;
          right: 1rem;
          background: var(--primary-orange);
          color: var(--white);
          padding: 0.5rem 1rem;
          border-radius: 8px;
          font-weight: 600;
          font-size: 0.875rem;
        }

        .image-overlay {
          position: absolute;
          top: 0;
          left: 0;
          right: 0;
          bottom: 0;
          background: rgba(0, 0, 0, 0.6);
          opacity: 0;
          visibility: hidden;
          pointer-events: none;
          transition: opacity 0.3s ease;

          .btn {
            position: absolute;
            top: 1rem;
            right: 1rem;
          }
        }
      }

      .apartment-image-link {
        display: block;
        width: 100%;
        text-align: left;
        background: transparent;
        border: 0;
        padding: 0;
        color: inherit;
        cursor: pointer;

        &:focus {
          outline: 3px solid var(--trust-navy);
          outline-offset: 2px;
        }

        &:focus .image-overlay {
          opacity: 1;
          visibility: visible;
          pointer-events: auto;
        }
      }

      .apartment-title {
        font-size: 1.375rem;
        font-weight: 600;
        margin-bottom: 1rem;
        color: var(--text-dark-gray);
        line-height: 1.3;
      }

      .apartment-details {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.75rem;
        margin-bottom: 1.5rem;

        .detail-item {
          display: flex;
          align-items: center;
          gap: 0.5rem;
          font-size: 0.875rem;
          color: var(--slate-accent);

          i {
            color: var(--primary-orange);
            width: 16px;
            font-size: 0.875rem;
          }
        }
      }

      .apartment-features {
        margin-bottom: 1.5rem;

        .feature-badge {
          display: inline-block;
          padding: 0.375rem 0.875rem;
          background: var(--light-gray);
          color: var(--text-dark-gray);
          border-radius: 16px;
          font-size: 0.75rem;
          font-weight: 500;

          &.furnished {
            background: rgba(250, 116, 45, 0.1);
            color: var(--primary-orange);
          }
        }
      }

      .apartment-actions {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
        justify-content: flex-start;

        .btn {
          flex: 0 0 auto;
          min-width: 120px;
          font-size: 0.875rem;
          padding: 0.75rem 1rem;
          text-align: center;
        }
      }

      @media (max-width: 374.98px) {
        .apartment-actions .btn {
          flex: 1 1 100%;
          font-size: 0.8125rem;
          padding: 0.625rem 0.5rem;
        }
      }
    }

    .no-results {
      padding: 4rem 0;
      color: var(--slate-accent);
    }

    .no-results i {
      font-size: 4rem;
      margin-bottom: 1.5rem;
      color: var(--light-gray);
    }

    .no-results h3 {
      margin-bottom: 1rem;
      color: var(--text-dark-gray);
    }
  }

  @media (max-width: 767.98px) {
    .hero-section .hero-content h1 {
      font-size: 2rem;
      margin-bottom: 1rem;
    }

    .hero-section .hero-content .hero-description {
      font-size: 1rem;
      margin-bottom: 1rem;
    }

    .apartments-grid-section {
      padding: 2rem 0;

      .apartments-grid {
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }
    }

    .apartment-card {
      .apartment-details {
        grid-template-columns: 1fr;
        gap: 0.5rem;
      }

      .apartment-actions {
        flex-direction: column;
        gap: 0.5rem;

        .btn {
          width: 100%;
          flex: 1 1 100%;
        }
      }
    }
  }

  @media (min-width: 768px) and (max-width: 1199.98px) {
    .apartments-grid-section .apartments-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
}

// Search Section
.search-section {
  padding: 4rem 0;
  background: var(--soft-warm-gray);

  .search-card {
    margin-top: -3rem;
    position: relative;
    z-index: 3;
    
    &:hover {
      transform: none !important;
    }
    
    h2 {
      color: var(--text-dark-gray);
      margin-bottom: 2rem;
    }
  }

  .search-header {
    h2 {
      font-size: clamp(1.5rem, 4vw, 2rem) !important;
      color: var(--text-dark-gray) !important;
      font-weight: 600 !important;
      margin-bottom: 1.5rem !important;
      word-wrap: break-word;
      line-height: 1.3;
      
      @media (max-width: 767.98px) {
        font-size: 1.5rem !important;
        margin-bottom: 1rem !important;
        padding: 0 0.5rem;
        line-height: 1.4;
      }
      
      @media (max-width: 374.98px) {
        font-size: 1.375rem !important;
        padding: 0 0.25rem;
      }
    }
    
    .btn-filters-toggle {
      background: var(--primary-orange);
      color: var(--white);
      border: none;
      border-radius: 8px;
      padding: 0.75rem 1.5rem;
      font-size: 1rem;
      font-weight: 600;
      transition: all 0.3s ease;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      
      &:hover {
        background: var(--trust-navy);
      }
      
      @media (min-width: 768px) {
        &:hover {
          transform: translateY(-2px);
        }
      }

      i {
        transition: transform 0.3s ease;
      }
    }
  }

  .search-form {
    overflow: hidden;
    transition: all 0.3s ease;
    
    &.collapse {
      max-height: 0;
      padding: 0;
      margin: 0;
      opacity: 0;
    }
    
    &.collapse.show {
      max-height: 500px; // Adjust based on content
      padding: 1.5rem 0 0 0;
      opacity: 1;
    }

    .form-group {
      margin-bottom: 1.5rem;
    }

    .form-label {
      font-weight: 600;
      color: var(--text-dark-gray);
      margin-bottom: 0.5rem;
    }

    .form-control {
      height: 48px;
      border: 2px solid var(--light-gray);
      border-radius: 8px;
      
      &:focus {
        border-color: var(--primary-orange);
        box-shadow: 0 0 0 3px rgba(250, 116, 45, 0.1);
      }
    }

    // Options grid (3 per row)
    .options-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.75rem 1.25rem;
      align-items: center;
    }

    .form-check {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      min-height: 40px;
    }

    .form-check-label .me-2 {
      display: inline-block;
      width: 1.25rem;
      text-align: center;
    }
  }
}

// About Agent Section
.about-agent {
  padding: 5rem 0;
  background: var(--soft-warm-gray);

  .agent-image {
    position: relative;

    img {
      width: 100%;
      max-width: 400px;
      border-radius: 16px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
    }
  }

  .agent-content {
    h2 {
      color: var(--text-dark-gray);
      font-size: 2rem;
      margin-bottom: 0.5rem;
    }

    .agent-name {
      color: var(--primary-orange);
      font-size: 1.5rem;
      font-weight: 600;
      margin-bottom: 1.5rem;
    }

    p {
      color: var(--slate-accent);
      font-size: 1.125rem;
      line-height: 1.7;
      margin-bottom: 2rem;
    }

    .agent-contact {
      margin-bottom: 2rem;
      text-align: center; // center the email line
      max-width: 400px;
      margin-left: auto;
      margin-right: auto;

      .contact-person {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 0.00rem;

        i {
          color: var(--primary-orange);
          font-size: 1.125rem;
          width: 20px;
        }

        .agent-name {
          color: var(--text-dark-gray);
          font-weight: 600;
          font-size: 1.125rem;
        }
      }

      .contact-item {
        display: flex;
        align-items: center;
        justify-content: center; // center icon + email horizontally
        gap: 1rem;
        margin-bottom: 0.75rem;

        i {
          color: var(--primary-orange);
          font-size: 1.125rem;
          width: 20px;
        }

        a {
          color: var(--text-dark-gray);
          text-decoration: none;
          font-weight: 500;
          font-size: 1rem;

          &:hover {
            color: var(--primary-orange);
          }
        }
      }
    }

    .agent-actions {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }
  }
}

// Responsive Design
@media (max-width: 767.98px) {
  .hero {
    height: 80vh;
    
    .hero-text {
      padding: 0 1rem;
      
      .btn {
        font-size: 1rem;
        padding: 0.875rem 2rem;
      }
    }
  }

  .search-section {
    padding: 2rem 0;

    .search-card {
      margin-top: -2rem;
    }
    
    .search-header h2 {
      font-size: 1.5rem;
      margin-bottom: 1rem;
    }

    .search-form .row {
      margin: 0;
      
      .col {
        padding: 0;
        margin-bottom: 1rem;
      }
    }
    
    .btn-filters-toggle {
      font-size: 0.9375rem;
      padding: 0.625rem 1.25rem;
    }
  }

  .featured-apartments {
    padding: 3rem 0;

    .apartments-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    
    .apartment-card .apartment-actions {
      flex-direction: column;
      gap: 0.5rem;
      
      .btn {
        width: 100%;
        flex: 1 1 100%;
      }
    }
  }

  .about-agent {
    padding: 3rem 0;

    .row {
      flex-direction: column-reverse;
    }

    .agent-content {
      text-align: center;
      margin-bottom: 2rem;
    }

    .agent-actions {
      justify-content: center;
    }
  }
}

@media (min-width: 768px) and (max-width: 1199.98px) {
  .apartments-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  
  .hero .hero-background {
    background-attachment: scroll;
  }
}

// Animation Delays
.apartment-card {
  &:nth-child(1) { animation-delay: 0.1s; }
  &:nth-child(2) { animation-delay: 0.2s; }
  &:nth-child(3) { animation-delay: 0.3s; }
  &:nth-child(4) { animation-delay: 0.4s; }
  &:nth-child(5) { animation-delay: 0.5s; }
  &:nth-child(6) { animation-delay: 0.6s; }
  &:nth-child(7) { animation-delay: 0.7s; }
  &:nth-child(8) { animation-delay: 0.8s; }
}

// Screen reader-only class for accessibility
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

// Improved focus styles for keyboard navigation
.apartment-card:focus-within {
  outline: 3px solid var(--primary-color, #0b3d91);
  outline-offset: 2px;
}

.btn:focus-visible,
a:focus-visible,
select:focus-visible,
input:focus-visible {
  outline: 3px solid var(--primary-color, #0b3d91);
  outline-offset: 2px;
}

// Ensure apartment details use proper definition list styling
.apartment-details {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  margin: 0;
  padding: 0;

  .detail-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;

    dt {
      // Screen reader only
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    dd {
      margin: 0;
    }
  }
}

// Mobile responsive styles for image overlay
@media (max-width: 768px) {
  .apartment-image-info {
    .info-title {
      font-size: 1rem !important;
    }

    .info-details {
      font-size: 0.75rem !important;
      gap: 0.375rem !important;
    }

    .info-action .view-details-text {
      font-size: 0.75rem !important;
    }
  }
}

// Touch device support (no hover capability)
@media (hover: none) {
  .apartment-image-link:active .apartment-image-info,
  .apartment-image-link:focus .apartment-image-info {
    opacity: 1;
    visibility: visible;
  }
}